version: 2
updates:
  - package-ecosystem: pip
    directories:
      - "/services/*"
      - "/dashboard"
    schedule:
      interval: weekly
    open-pull-requests-limit: 5
  - package-ecosystem: docker
    directories:
      - "/services/*"
      - "/dashboard"
    schedule:
      interval: weekly
  - package-ecosystem: github-actions
    directory: "/"
    schedule:
      interval: weekly