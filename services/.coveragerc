[run]
# chemins relatifs depuis services/
source =
    web_watcher
    vuln_scanner
    social_monitor
    ransomware_monitor
    alert_service

omit =
    */tests/*
    */venv/*

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise NotImplementedError
    if __name__ == .__main__.: